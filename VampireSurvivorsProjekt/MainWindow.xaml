<Window x:Class="VampireSurvivorsProjekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VampireSurvivorsProjekt"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280" ResizeMode="NoResize">


    <Grid>

        <Canvas x:Name="GameCanvas" Background="Green">

        </Canvas>

        <Border VerticalAlignment="Top"
                BorderThickness="3"
                CornerRadius="3"
                Padding="1"
                BorderBrush="Gold">

            <ProgressBar Name="XpBar" 
             Height="20" 
             VerticalAlignment="Top" 
             Foreground="#FF00E5FF" 
             Background="#44000000" 
             BorderThickness="0"
             Minimum="0" 
             Maximum="10" 
             Value="0" />
        </Border>


        <StackPanel>

        </StackPanel>
    </Grid>



</Window>
