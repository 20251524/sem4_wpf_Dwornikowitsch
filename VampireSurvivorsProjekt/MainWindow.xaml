<Window x:Class="VampireSurvivorsProjekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VampireSurvivorsProjekt"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280" ResizeMode="NoResize">


    <Grid>

        <Canvas x:Name="GameCanvas" Background="Green">

        </Canvas>

        <Border VerticalAlignment="Top"
                BorderThickness="3"
                CornerRadius="3"
                Padding="1"
                BorderBrush="Gold">

            <ProgressBar Name="XpBar" 
             Height="20" 
             VerticalAlignment="Top" 
             Foreground="#FF00E5FF" 
             Background="#44000000" 
             BorderThickness="0"
             Minimum="0" 
             Maximum="10" 
             Value="0" />
        </Border>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,40,0,0">
            <TextBlock Text="LEBEN:" Foreground="Red" FontWeight="Bold" FontSize="12" Margin="0,0,0,2"/>
            <ProgressBar x:Name="HpBar" Width="200" Height="15" Background="#330000" Foreground="Red" Minimum="0"/>
        </StackPanel>

        <TextBlock Name="TxtInGameTimer" 
           Text="00:00" 
           FontSize="28" 
           Foreground="White" 
           FontWeight="Bold"
           HorizontalAlignment="Center" 
           VerticalAlignment="Top" 
           Margin="0,35,0,0">

            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="3" Color="Black" Direction="315" ShadowDepth="2"/>
            </TextBlock.Effect>
        </TextBlock>

        <Grid Name="StartScreen" Visibility="Visible" Background="#222222">
            <Border Background="#333333" CornerRadius="10" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Gold" BorderThickness="2">
                <StackPanel Width="300">
                    <TextBlock Text="SURVIVORS" FontSize="36" Foreground="Gold" HorizontalAlignment="Center" Margin="0,0,0,30" FontWeight="Bold"/>
                    <TextBlock Text="Spielername:" Foreground="White" Margin="0,0,0,5" FontSize="14"/>
                    <TextBox Name="TxtPlayerName" Text="Spieler 1" Padding="8" Margin="0,0,0,20" FontSize="14" Background="#555" Foreground="White" BorderBrush="Gray"/>
                    <Button Content="SPIEL STARTEN"  Padding="15" Click="StartGame_Click" Background="Gold" Foreground="Black" FontWeight="Bold" FontSize="16"/>
                    <Button Content="HIGHCORES ANZEIGEN" Click="OpenHighscores_Click" Padding="10" Background="#444" Foreground="White" FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Name="GameOverScreen" Visibility="Collapsed" Background="#AA000000">
            <Border Background="#111111" CornerRadius="10" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Red" BorderThickness="2">
                <StackPanel Width="300">
                    <TextBlock Text="GAME OVER" FontSize="42" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="Bold"/>
                    <TextBlock Name="TxtStatsTime" Text="Überlebte Zeit: 00:00" Foreground="White" HorizontalAlignment="Center" Margin="0,5" FontSize="16"/>
                    <TextBlock Name="TxtStatsKills" Text="Besiegte Gegner: 0" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,30" FontSize="16"/>
                    <Button Content="NOCHMALS SPIELEN" Click="RestartGame_Click" Padding="15" Background="#333" Foreground="White" FontSize="16"/>
                    <Button Content="HAUPTMENÜ" Click="BackToMenu_Click" Padding="10" Background="#333" Foreground="White" FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <Grid Name="HighscoreScreen" Visibility="Collapsed" Background="#222222">
        <Border Background="#333333" CornerRadius="10" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Gold" BorderThickness="2">
            <StackPanel Width="400">
                <TextBlock Text="BESTENLISTE" FontSize="32" Foreground="Gold" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="Bold"/>
                
                <TextBlock Name="TxtHighscoreList" Text="Lade Daten..." Foreground="White" FontSize="14" FontFamily="Consolas" Margin="0,0,0,20"/>
                
                <Button Content="ZURÜCK" Click="CloseHighscores_Click" Padding="10" Background="#444" Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>




        <Grid Name="LevelUpMenu" Visibility="Collapsed" Background="#AA000000">
            <Border Background="#222222" CornerRadius="10" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="Gold" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="LEVEL UP!" FontSize="36" Foreground="Gold" HorizontalAlignment="Center" Margin="0,0,0,20" FontWeight="Bold"/>

                    <Button Name="BtnChoice1" Content="" Tag="" Click="HandleUpgrade" Margin="5" Width="250" Padding="10" Background="#333" Foreground="White"/>
                    <Button Name="BtnChoice2" Content="" Tag="" Click="HandleUpgrade" Margin="5" Width="250" Padding="10" Background="#333" Foreground="White"/>
                    <Button Name="BtnChoice3" Content="" Tag="" Click="HandleUpgrade" Margin="5" Width="250" Padding="10" Background="#333" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>



</Window>
